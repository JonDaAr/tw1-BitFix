FROM maven:3.9.16-eclipse-temurin-25 AS build

WORKDIR /workspace

COPY pom.xml checkstyle-base.xml pmd-reglas-de-codigo.xml ./
COPY src ./src

RUN --mount=type=cache,target=/root/.m2 mvn -B -ntp package

FROM tomcat:10.1-jdk25-temurin AS runtime

COPY --from=build /workspace/target/tallerwebi-base-1.0-SNAPSHOT.war /usr/local/tomcat/webapps/spring.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
